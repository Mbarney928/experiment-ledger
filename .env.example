# Copy to .env and fill in. .env is gitignored — never commit it.

# REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# SQLite for local dev; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./experiment_ledger.db

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_MINUTES=60
LOGIN_RATE_LIMIT=5/60
LOG_LEVEL=INFO
LOG_JSON=true

# Only used by docker-compose for the local Postgres container.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-16
